# MoodyMate production settings: PLACEHOLDERS ONLY (BE-34.2, D-62 §5, D-50 §2).
#
# Copy this file to .env.production (ignored by git, like every .env.*) or render it from your
# secret store, then replace every <...> value. Nothing here is a working secret. Secrets (the
# database password, METRICS_TOKEN, ERROR_TRACKER_DSN) come from the environment or a secret
# store only: never from an image, a build arg or this repository.
#
# `docker compose --profile prod` reads the file named by MOODYMATE_ENV_FILE (default
# .env.production). NEXT_PUBLIC_API_BASE_URL is not read from here: it is a frontend build
# arg, passed to `docker compose` itself (see docker-compose.yml).
#
# Every setting and its default is in backend/app/core/config.py. The settings below are the
# ones a production deployment must decide.

# --- Environment (D-13, D-14) ---
ENV=production
# `client` only in production (D-14). The placeholder stops startup until it is replaced.
DATA_CLASS=<client-or-synthetic>
LOG_LEVEL=INFO

# --- Database: the password comes from your secret store ---
DATABASE_URL=postgresql+asyncpg://<db-user>:<db-password>@<db-host>:5432/<db-name>

# --- Authentication (D-09). AUTH_MODE=dev is refused outside local/test (D-13). ---
AUTH_MODE=oidc
OIDC_ISSUER=https://<idp-host>/realms/<realm>
OIDC_AUDIENCE=<api-audience>
OIDC_CLIENT_ID=<frontend-client-id>
# Optional; defaults to the issuer's discovery document:
# OIDC_JWKS_URL=https://<idp-host>/<jwks-path>

# --- The frontend origin(s) allowed by CORS (a JSON list) ---
CORS_ORIGINS=["https://<frontend-host>"]

# --- Reverse proxy: uvicorn runs with --proxy-headers ---
# Only these addresses may set X-Forwarded-For/-Proto (comma-separated). Never `*`.
# The proxy addresses are a client decision before production.
FORWARDED_ALLOW_IPS=<proxy-ip>

# --- Raw artifact store (D-15). The compose prod profile mounts a volume here. ---
ARTIFACT_STORE_DIR=/var/lib/moodymate/artifacts

# --- Observability (D-62) ---
# One JSON access line per request; never a query, body, header or token (§3).
ACCESS_LOG_ENABLED=true
# Off by default (§2). When on, the listener is internal only (docker-compose.yml) and should
# require a bearer token from your secret store (docs/ops/INCIDENT_RESPONSE.md):
METRICS_ENABLED=false
# METRICS_TOKEN=<random-token-from-secret-store>
# Error tracker (§4): the vendor is not chosen (a client decision), so this stays empty. Keep the
# line commented out: an uncommented empty value counts as set and logs a startup warning.
# ERROR_TRACKER_DSN=
