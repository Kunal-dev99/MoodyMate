# Copy to backend/.env for local overrides. Never commit .env.
ENV=local
DATABASE_URL=postgresql+asyncpg://moodymate:moodymate@localhost:5432/moodymate_dev
AUTH_MODE=dev
AI_ENABLED=false
DATA_CLASS=synthetic
LOG_LEVEL=INFO
# AUTH_MODE=oidc requires:
# OIDC_ISSUER=https://idp.example.com/realms/moodymate
# OIDC_AUDIENCE=moodymate-api
# OIDC_CLIENT_ID=moodymate-web
# AUTH_MODE=dev outside local/test requires AUTH_DEV_SECRET (>= 32 chars)
