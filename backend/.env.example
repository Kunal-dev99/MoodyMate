# Copy to backend/.env for local overrides. Never commit .env.
# ENV is required (D-13): local | test | staging | production. Dev auth: local/test only.
ENV=local
DATABASE_URL=postgresql+asyncpg://moodymate:moodymate@localhost:5432/moodymate_dev
AUTH_MODE=dev
AI_ENABLED=false
DATA_CLASS=synthetic
LOG_LEVEL=INFO
# AUTH_MODE=oidc requires:
# OIDC_ISSUER=https://idp.example.com/realms/moodymate
# OIDC_AUDIENCE=moodymate-api
# OIDC_CLIENT_ID=moodymate-web
# AUTH_MODE=dev is refused outside ENV=local|test (D-13); AUTH_DEV_SECRET must be >= 32 chars.
# D-15: root of the write-once raw artifact store. Required outside local/test; must be an
# absolute path OUTSIDE the repository. Pair one directory with each DB copy (D-03), e.g.
# ARTIFACT_STORE_DIR=/home/you/MoodyMate-wt/artifacts-<feature>
# Unset in local/test: <system temp dir>/moodymate-artifacts.
# D-16 upload bounds (hard ceilings shown; settings may only lower them):
# IMPORT_MAX_BYTES=10485760
# IMPORT_MAX_ROWS=50000
# IMPORT_MAX_COLUMNS=200
# IMPORT_MAX_CELL_CHARS=4000
# IMPORT_MAX_XLSX_UNCOMPRESSED_BYTES=52428800
# IMPORT_MAX_XLSX_RATIO=100
# D-25 §1: decoded cell characters of one upload (every format):
# IMPORT_MAX_DECODED_CHARS=52428800
# Phase 33 (D-59 §6). Required outside local/test (D-13): the list-cursor signing key, at
# least 32 random characters and never the built-in development key.
# CURSOR_SIGNING_KEY=
# The artifact store: filesystem (default) or s3, which needs the `s3` extra
# (pip install -e ".[s3]", boto3 >= 1.35.2) and, outside local/test, ARTIFACT_S3_REGION
# and an https:// endpoint when one is set. The key pair is both or neither (neither: the
# client's default credential chain, e.g. an instance role).
# ARTIFACT_STORE_KIND=filesystem
# ARTIFACT_S3_BUCKET=
# ARTIFACT_S3_PREFIX=
# ARTIFACT_S3_REGION=
# ARTIFACT_S3_ENDPOINT_URL=
# ARTIFACT_S3_ACCESS_KEY_ID=
# ARTIFACT_S3_SECRET_ACCESS_KEY=
