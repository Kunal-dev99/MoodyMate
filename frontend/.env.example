# Copy to frontend/.env.local. Public values only: NEXT_PUBLIC_* ships to the browser.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# D-02: "off" restores the Phase 7 Imports tab ("planned") and hides the import wizard (FE-8.1/8.2).
# NEXT_PUBLIC_IMPORTS_UI=off
# D-02: "off" restores the "planned" Financial Domain workspace and hides "Project to domain" (FE-14.1/14.2).
# NEXT_PUBLIC_DOMAIN_UI=off
# D-02: "off" ends an expired session as before Phase 35: no silent renew, no route-keeping redirect (FE-35.4).
# NEXT_PUBLIC_REAUTH_UI=off
# D-02: "off" drops the per-route nav-permission gate of the (platform) layout (FE-35.5).
# NEXT_PUBLIC_ROUTE_GATES_UI=off
